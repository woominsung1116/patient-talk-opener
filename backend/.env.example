# 복사해서 .env로 저장: cp .env.example .env

# 환자 목소리 — Gemini TTS (여동생 운전 가르치기와 동일 구성)
# https://aistudio.google.com/apikey 에서 무료 발급
# 비워두면 자동으로 edge-tts(무료 뉴럴 보이스)로 폴백
GEMINI_API_KEY=

# LLM 엔진: codex (Codex CLI 래퍼, 기본) | ollama (로컬, 빠름)
LLM_ENGINE=codex

# Ollama 폴백/직접 사용 시 모델
OLLAMA_MODEL=qwen2.5:7b-instruct
